# Base de datos (usadas por docker compose y para armar DATABASE_URL)
POSTGRES_USER=circuitos
POSTGRES_PASSWORD=cambiar-en-produccion
POSTGRES_DB=circuitos

# Puerto del host mapeado al Postgres del contenedor (5435 para no chocar con un Postgres local)
DB_PORT=5435
# Conexión desde fuera de docker (tests, migraciones locales)
DATABASE_URL=postgres://circuitos:cambiar-en-produccion@localhost:5435/circuitos

# API
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Admin único (hash bcrypt: generar con `pnpm --filter api hash-password <password>`)
ADMIN_USER=admin
# IMPORTANTE: dejar el hash entre comillas simples, si no docker compose
# interpreta los '$' del bcrypt como variables
ADMIN_PASSWORD_HASH=''
# Secreto JWT (generar con `openssl rand -hex 32`)
JWT_SECRET=

# Dónde guarda la API el GPX original y las fotos.
# Sin definir usa ./data/ (desarrollo); el compose los apunta a los volúmenes.

# Frontend: vacío = mismo origen (el proxy de vite reenvía /api a la API).
# Definirlo solo si el frontend vive en otro dominio que la API (producción).
VITE_API_URL=

# Correo saliente, solo para recuperar la contraseña (Resend).
# SIN DEFINIR NO FALLA: el enlace se escribe en el log de la API en vez de enviarse.
RESEND_API_KEY=
EMAIL_FROM='Circuitos Argentinos <no-responder@makkem.com>'
# Base para armar el enlace del correo: es el sitio, no la API.
APP_URL=http://localhost:5173
# A dónde avisar cuando alguien propone un circuito desde el sitio.
PROPUESTAS_EMAIL=valentincarpio32@gmail.com
