// Despliegue del frontend en Cloudflare Workers (assets estáticos, sin código de
// servidor). Cloudflare conecta el repo por Workers Builds y en cada push a main
// corre el build de vite y sube el contenido de dist.
//
// `not_found_handling` en modo SPA hace que cualquier ruta desconocida devuelva
// index.html con estado 200, que es lo que necesita el router del navegador para
// que los enlaces compartidos (/circuitos/:slug, /admin) abran directo.
{
  "name": "circuitos-argentinos",
  "compatibility_date": "2026-07-26",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
