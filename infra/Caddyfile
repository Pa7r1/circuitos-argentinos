api.circuitosargentinos.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# las imágenes se sirven directo del volumen, sin pasar por node
	handle_path /media/* {
		root * /srv/media
		file_server
		header Cache-Control "public, max-age=604800"
	}

	reverse_proxy api:3000
}
